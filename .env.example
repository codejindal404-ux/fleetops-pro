# Server Port
PORT=3000

# Authentication & JWT Security
JWT_SECRET="fleetops_prod_secret_jwt_key_2026_x89312"
JWT_EXPIRES_IN="8h"
BCRYPT_SALT_ROUNDS=10

# CORS Security Allowed Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000"

# Firebase Database & Auth Configuration (Firestore)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_ID="(default)"

# Email Configuration (Nodemailer / Gmail SMTP)
# For Gmail SMTP:
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Go to "App passwords" (myaccount.google.com/apppasswords)
# 3. Create a new App Password for "FleetOps Pro" (16 characters)
# 4. Paste the generated 16-character password into EMAIL_PASS below
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-character-google-app-password"
EMAIL_FROM="FleetOps Pro <your-email@gmail.com>"

# Optional SMTP_* alias fallback
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-google-app-password"
SMTP_FROM="FleetOps Pro <your-email@gmail.com>"

# Frontend API URL (leave blank if backend is served on same domain/port)
VITE_API_URL=""

# Optional GEMINI_API_KEY for AI integrations
GEMINI_API_KEY=""
